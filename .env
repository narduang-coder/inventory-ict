# XAMPP LOCAL DEVELOPMENT ONLY - DO NOT USE THIS FILE IN PRODUCTION
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Vientiane
APP_BASE_URL=/edl-inven
# IMPORTANT: set this to the PC LAN address so phones can open QR links.
# Example: APP_PUBLIC_URL=http://192.168.1.100/edl-inven
APP_PUBLIC_URL=
APP_QR_SECRET=CHANGE_ME_LOCAL_QR_SECRET

# Default XAMPP MariaDB/MySQL configuration.
# If you configured a password for root, put it in DB_PASS.
DB_HOST=db
DB_NAME=inventory_db
DB_USER=inventory_user
DB_PASS=627346
