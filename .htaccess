Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:\.env(?:\..*)?|composer\.(?:json|lock)|.*\.sql)$ - [F,L,NC]
    RewriteRule ^(?:includes|database|logs|docs)(?:/|$) - [F,L,NC]
    RewriteRule ^migration_runner\.php$ - [F,L,NC]
</IfModule>

<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(?:sql|bak|backup|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>
